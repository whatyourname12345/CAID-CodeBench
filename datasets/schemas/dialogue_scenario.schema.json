{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAIR Dialogue Scenario",
  "type": "object",
  "required": [
    "task_id",
    "repo",
    "base_commit",
    "persona",
    "initial_user_query",
    "hidden_problem_statement",
    "gold_intent_state_path"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "repo": {"type": "string"},
    "base_commit": {"type": "string"},
    "persona": {"type": "object"},
    "initial_user_query": {"type": "string"},
    "hidden_problem_statement": {"type": "string"},
    "gold_intent_state_path": {"type": "string"},
    "misleading_cues": {"type": "array"},
    "disclosure_policy": {"type": "object"},
    "metadata": {"type": "object"}
  }
}
